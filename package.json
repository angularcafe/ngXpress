{
  "name": "ngxpress",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "prisma migrate deploy && node dist/ngxpress/server/server.mjs",
    "dev": "ng serve",
    "build": "prisma generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "auth:generate": "auth generate --config src/api/lib/auth.ts --adapter prisma --dialect postgresql --output prisma/models/auth.prisma --yes"
  },
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.5",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@spartan-ng/brain": "^1.3.2",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "ngx-scrollbar": "^19.1.5",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@spartan-ng/cli": "^1.3.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
